# Required: AUTH_SECRET, DATABASE_URL, WS_SECRET (validated at startup by src/env.js).
# Set SKIP_ENV_VALIDATION=1 for CI steps that don't need a real environment.

AUTH_SECRET=your-secret-key-here-min-32-characters-long

# Postgres connection strings, not the Supabase project URL. Copy from
# Supabase -> Connect; the aws-0/aws-1 prefix and region differ per project.
# DATABASE_URL is the transaction pooler (6543) — matches `prepare: false`.
# DATABASE_DIRECT_URL is read only by drizzle.config.ts for migrations, and uses
# the session pooler (5432): transaction mode can't run DDL, and the direct
# db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Any OpenAI-compatible endpoint. The agents need native tool calling —
# verify with `pnpm llm:probe`. LLM_FALLBACK_MODEL empty = no fallback.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=

# Cheap model for short, mechanical work: conversation titles, rolling
# summaries, JSON repair. Unset = use LLM_MODEL for those too.
LLM_MODEL_FAST=

# Interactive AI requests per user per rolling 24h. Scheduled (proactive) runs
# draw on their own budget so a daily brief can never spend the quota the user
# was going to use themselves.
AI_RATE_LIMIT=50
AI_SYSTEM_RATE_LIMIT=20

NEXT_PUBLIC_APP_URL=http://localhost:3000

WS_SECRET=change-me-to-a-random-string-at-least-32-chars
WS_PORT=3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
WS_INTERNAL_URL=http://localhost:3001

# Proactive AI (daily brief, risk radar) needs the ws-server running: it holds
# the scheduler and calls POST /api/internal/ai/run-schedules using WS_SECRET.
# It is opt-in per user under Settings -> AI assistant, and stays off until then.
#
# Agent search wants its indexes: psql "$DATABASE_DIRECT_URL" -f scripts/sql/search-indexes.sql
# (searchWorkspace is correct without them, just slower.)

# Optional, unset here so their features are off: OAuth sign-in
# (AUTH_GOOGLE_*, AUTH_MICROSOFT_*, AUTH_DISCORD_*), uploads (UPLOADTHING_TOKEN),
# email (RESEND_API_KEY, RESEND_FROM_EMAIL), maps (NEXT_PUBLIC_GOOGLE_MAPS_API_KEY),
# and multi-instance rate limits and sockets (REDIS_NATIVE_URL).
