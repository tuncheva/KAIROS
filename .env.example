# Required: AUTH_SECRET, DATABASE_URL, WS_SECRET (validated at startup by src/env.js).
# Set SKIP_ENV_VALIDATION=1 for CI steps that don't need a real environment.

AUTH_SECRET=your-secret-key-here-min-32-characters-long

# Postgres connection strings, not the Supabase project URL. Copy from
# Supabase -> Connect; the aws-0/aws-1 prefix and region differ per project.
# DATABASE_URL is the transaction pooler (6543) — matches `prepare: false`.
# DATABASE_DIRECT_URL is read only by drizzle.config.ts for migrations, and uses
# the session pooler (5432): transaction mode can't run DDL, and the direct
# db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Which provider serves the agents here. Named presets in
# src/server/llm/core/providers.ts carry the base URL, model chain and key
# variable for one gateway, so a machine switches provider on this line alone:
#
#   nvidia    free NIM tier, deepseek-ai/deepseek-v4-flash (+ v4-pro fallback).
#             Development only — its terms forbid personal data and permit
#             training on content. See docs/llm-provider-research-2026-08-21.md.
#   velocity  chat.velocity.online gateway, deepseek/deepseek-v4-flash.
#   deepseek  DeepSeek's own API, deepseek-chat.
#
# Each preset reads LLM_API_KEY_<PROVIDER> in preference to the shared
# LLM_API_KEY, so every machine's key can live in one .env and only the selected
# one is used. Unset LLM_PROVIDER = configure LLM_BASE_URL / LLM_MODEL yourself.
LLM_PROVIDER=nvidia
LLM_API_KEY_NVIDIA=nvapi-your-key-here
LLM_API_KEY_VELOCITY=
LLM_API_KEY_DEEPSEEK=

# Any OpenAI-compatible endpoint. The agents need native tool calling —
# verify with `pnpm llm:probe`, which resolves the same way the app does.
#
# These override the preset when set, and work on their own with LLM_PROVIDER
# unset. An explicit LLM_MODEL drops the preset's fallback too: pairing a
# hand-picked model with a fallback it was never tested against is worse than
# none. LLM_FALLBACK_MODEL empty = no fallback.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=

# Cheap model for short, mechanical work: conversation titles, rolling
# summaries, JSON repair. Unset = the preset's fast model, else LLM_MODEL.
#
# Set this whenever you override LLM_MODEL. The preset's fast id is only correct
# for the preset's endpoint, so an overridden LLM_MODEL with this left unset
# leads the fast chain with a model the gateway does not serve — one wasted round
# trip per fast-tier call before it falls through.
LLM_MODEL_FAST=

# How much chain-of-thought the strong tier spends. Unset = each model family's
# own default ("medium" for DeepSeek V4 Flash). Reasoning tokens are emitted
# before the first visible character and then discarded, so this is the dominant
# term in time-to-first-token; "low" is the right starting point for interactive
# chat and only worth raising if answer quality measurably suffers.
LLM_REASONING_EFFORT=low

# Semantic (vector) search for uploaded documents.
# Set LLM_EMBEDDING_MODEL to activate. The same LLM_BASE_URL + LLM_API_KEY are
# reused if the provider serves embeddings too. Set the _EMBEDDING_ overrides
# below when using a dedicated embedding provider (e.g. OpenAI embeddings +
# Velocity chat).
#
# The DB columns are vector(1024), matching jina-embeddings-v3 and most providers
# with a usable free tier. pgvector fixes the dimension at the column, so a model
# of a different width needs LLM_EMBEDDING_DIMS *and* a migration altering all
# three columns (document_chunks, tasks, sticky_notes) and rebuilding their HNSW
# indexes. Setting this alone gives a Postgres error on insert, not degraded
# results. `pnpm db:verify` asserts the width.
# LLM_EMBEDDING_MODEL=jina-embeddings-v3
# LLM_EMBEDDING_BASE_URL=https://api.jina.ai/v1
# LLM_EMBEDDING_API_KEY=jina-your-key-here
# LLM_EMBEDDING_DIMS=1024

# Interactive AI requests per user per rolling 24h. Scheduled (proactive) runs
# draw on their own budget so a daily brief can never spend the quota the user
# was going to use themselves.
AI_RATE_LIMIT=50
AI_SYSTEM_RATE_LIMIT=20

NEXT_PUBLIC_APP_URL=http://localhost:3000

WS_SECRET=change-me-to-a-random-string-at-least-32-chars
WS_PORT=3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
WS_INTERNAL_URL=http://localhost:3001

# Proactive AI (daily brief, risk radar) needs the ws-server running: it holds
# the scheduler and calls POST /api/internal/ai/run-schedules using WS_SECRET.
# It is opt-in per user under Settings -> AI assistant, and stays off until then.
#
# Agent search wants its indexes: psql "$DATABASE_DIRECT_URL" -f scripts/sql/search-indexes.sql
# (searchWorkspace is correct without them, just slower.)

# Optional, unset here so their features are off: OAuth sign-in
# (AUTH_GOOGLE_*, AUTH_MICROSOFT_*, AUTH_DISCORD_*), uploads (UPLOADTHING_TOKEN),
# email (RESEND_API_KEY, RESEND_FROM_EMAIL), and multi-instance rate limits and
# sockets (REDIS_NATIVE_URL).

# Redis. Unset, the app runs single-instance: rate-limit windows live in one
# process's memory (so the effective limit multiplies by instance count and
# resets on deploy) and socket events do not cross instances. Setting it requires
# the optional `redis` and `@socket.io/redis-adapter` packages to be installed —
# they are declared in optionalDependencies, so `pnpm install` picks them up.
# REDIS_NATIVE_URL=redis://localhost:6379

# Log verbosity for both the app and ws-server: error | warn | info | debug.
# Unset = debug in development, info in production.
# LOG_LEVEL=info

# Set to 1 to send Content-Security-Policy-Report-Only instead of enforcing it.
# Use when changing the policy, to see what would break before it does.
# CSP_REPORT_ONLY=

# ---------------------------------------------------------------------------
# Stripe. Unset, the plan resolver still works and nobody can buy anything:
# checkout and the portal answer PRECONDITION_FAILED and the pricing page
# renders its tiers with the buttons explaining they are unavailable.
#
# The webhook secret is not optional in practice. A deployment that can create
# checkout sessions but cannot verify the webhook takes money and never grants
# the plan, so `isBillingConfigured()` requires both before offering checkout.
#
# Local development: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints the signing secret to use here. It is different from the dashboard's.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# One price id per (plan x interval), from the Stripe dashboard. A plan with
# neither interval configured is hidden from checkout rather than erroring.
# Create them as *recurring* prices in EUR, per-seat: Pro 12/mo and 120/yr,
# Team 22/mo and 220/yr. See docs/business/pricing-strategy.html.
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_TEAM_ANNUAL=price_...

# Stripe rejects relative redirect URLs, so checkout needs this set to an
# absolute origin. Unset it falls back to http://localhost:3000.
# NEXT_PUBLIC_APP_URL=https://kairos.example.com
