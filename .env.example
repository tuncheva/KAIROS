# Environment Variables
# Copy this file to .env and fill in your values
#
# THREE VARIABLES ARE REQUIRED and validated at startup by src/env.js. The app
# refuses to boot without them rather than falling back to defaults:
#
#   AUTH_SECRET   — min 32 characters
#   DATABASE_URL  — must be a valid URL
#   WS_SECRET     — min 32 characters
#
# Everything else is optional; those features degrade cleanly when unset.
# For CI steps that don't need a real environment (lint, typecheck), set
# SKIP_ENV_VALIDATION=1.

# ─────────────────────────────────────────────────────────────
# Authentication (NextAuth.js)
# ─────────────────────────────────────────────────────────────
# REQUIRED, min 32 chars. Generate one with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-min-32-characters-long

# OAuth Providers (optional — enable the ones you need)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL via Supabase)
# ─────────────────────────────────────────────────────────────
# REQUIRED. No default — a missing value is a startup error, not a silent
# fallback to localhost.
DATABASE_URL=postgresql://user:password@localhost:5432/kairos

# ─────────────────────────────────────────────────────────────
# File Uploads (UploadThing)
# ─────────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=

# ─────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="Kairos <noreply@yourdomain.com>"

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Google Maps (optional)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────
# LLM Agent System (HuggingFace Inference API — OpenAI-compatible)
# ─────────────────────────────────────────────────────────────
# Required for AI agents to function
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_your-huggingface-token-here

# Llama 3-tier fallback chain (optional — these are the defaults)
LLM_DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_FALLBACK_MODEL=meta-llama/Llama-3.2-3B-Instruct
LLM_ALTERNATE_MODEL=Qwen/Qwen2.5-7B-Instruct

# ─────────────────────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────────────────────
# Set to "1" to skip environment validation during builds
# SKIP_ENV_VALIDATION=1

# ─────────────────────────────────────────────────────────────
# WebSocket (standalone WS server)
# ─────────────────────────────────────────────────────────────
# Required: min 32 chars. Shared between Next.js and WS server.
WS_SECRET=change-me-to-a-random-string-at-least-32-chars
# Port for the standalone WS server (default: 3001)
WS_PORT=3001
# Client-side WS URL (browser connects here)
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Internal URL used by the publisher HTTP fallback (dev)
WS_INTERNAL_URL=http://localhost:3001
# Optional: Redis URL for multi-instance production scaling
# REDIS_NATIVE_URL=redis://localhost:6379
